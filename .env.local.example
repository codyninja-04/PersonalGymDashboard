NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# AI provider fallback chain — all keys are SERVER-ONLY (no NEXT_PUBLIC_).
# The chain tries Gemini → Groq → OpenRouter, picking the first key that works.
# Add 1–3 keys per provider; missing keys are skipped automatically.
# Get keys here:
#   Gemini      → https://aistudio.google.com/apikey         (free, 15 RPM)
#   Groq        → https://console.groq.com/keys              (free, ~30 RPM, fastest)
#   OpenRouter  → https://openrouter.ai/keys                 (free models available)
# ============================================================================
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
